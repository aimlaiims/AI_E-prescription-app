# Daily database backup (run by cvf-backup.timer). Keeps 30 days in
# /var/backups/cvf, plus every report file in /var/backups/cvf/reports.
# Copy that folder off this machine too (see deploy/README.md).
[Unit]
Description=Prescription app database backup
After=postgresql.service

[Service]
Type=oneshot
User=cvf
Group=cvf
WorkingDirectory=@APP_DIR@/backend
Environment=REPORTS_DIR=/var/lib/cvf/reports
ExecStart=@APP_DIR@/backend/venv/bin/python -m tools.backup_database --to /var/backups/cvf --keep 30
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/backups/cvf
