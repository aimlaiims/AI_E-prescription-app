# --- Transcription backend ---
# "groq" (cloud, fast, needs GROQ_API_KEY) or "local" (faster-whisper, runs on your machine)
WHISPER_BACKEND=groq
GROQ_API_KEY=your_groq_api_key_here

# Only used if WHISPER_BACKEND=local
LOCAL_WHISPER_MODEL=base.en
LOCAL_WHISPER_DEVICE=cpu

# --- Field-extraction LLM (structured JSON parsing of the transcript) ---
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# EXTRACTION_MODEL=claude-sonnet-4-6

# --- Field-extraction LLM (structured JSON parsing of the transcript) ---
GEMINI_API_KEY=your_gemini_api_key_here
EXTRACTION_MODEL=gemini-3.5-flash

# --- Storage ---
DATABASE_URL=sqlite:///./clinical_forms.db

# --- Server ---
CORS_ORIGINS=http://localhost:5173
