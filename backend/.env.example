# --- Transcription (speech-to-text) ---
# "groq" = cloud Whisper via Groq (fast, needs GROQ_API_KEY)
# "local" = faster-whisper on this machine (needs: pip install -r requirements-local-whisper.txt)
WHISPER_BACKEND=groq
GROQ_API_KEY=your_groq_api_key_here

# Only used if WHISPER_BACKEND=local
LOCAL_WHISPER_MODEL=base.en
LOCAL_WHISPER_DEVICE=cpu

# --- Field extraction LLM (turns the transcript into structured field updates) ---
GEMINI_API_KEY=your_gemini_api_key_here
# flash-lite = fastest tier, built for simple extraction (current default).
# Switch to gemini-3.5-flash only if accuracy on tricky phrasing needs it — if you do,
# check that answers aren't cut short (max_output_tokens is 1024 in extraction.py).
EXTRACTION_MODEL=gemini-3.5-flash-lite

# --- Storage ---
# SQLite (one file; fine for one server and a few doctors):
DATABASE_URL=sqlite:///./clinical_forms.db
# PostgreSQL (create an empty database first; the app creates the tables itself):
# DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/cvf

# --- Many users at once (voice) ---
# Calls in progress at the same time, per provider; more wait in a fair queue.
GROQ_MAX_IN_FLIGHT=8
GEMINI_MAX_IN_FLIGHT=8
# Calls started per minute, per provider (0 = no limit here). Set a little BELOW your
# plan's requests-per-minute limit (see the provider's console) so requests wait
# briefly here instead of being refused there.
GROQ_PER_MINUTE=0
GEMINI_PER_MINUTE=0
# Longest wait in that queue before "many people are using voice input" is shown.
VOICE_QUEUE_WAIT_SECONDS=15
# Longest one call may take once started.
TRANSCRIBE_TIMEOUT_SECONDS=30
EXTRACT_TIMEOUT_SECONDS=30
# Voice requests one user may have in progress at once; largest recording accepted.
VOICE_MAX_PER_USER=3
MAX_AUDIO_MB=10

# Timezone for every date/time people see and for the date in Reference IDs
# (times are stored as UTC). If changed, also change APP_TIME_ZONE in frontend/src/dates.js.
APP_TIMEZONE=Asia/Kolkata

# --- Server ---
# Only matters if the browser talks to the API directly (cross-origin).
# With the Vite dev/preview proxy (default setup, incl. ngrok) requests are same-origin.
CORS_ORIGINS=http://localhost:5173

# --- Doctor accounts ---
# No self sign-up: the department's administrator adds accounts in the app (Accounts).
# The first administrator is created once on the server:
#   python -m tools.create_admin --email hod@example.org --name "Full Name"
# A new account's set-password link works this many days:
INVITE_LINK_DAYS=7
# Shown on the letterhead and printed prescriptions.
INSTITUTION_NAME=All India Institute of Medical Sciences, Raipur
# Sessions last 12 hours, or 30 days with "Keep me signed in".
SESSION_HOURS=12
REMEMBER_DAYS=30
# Session cookie "Secure" flag: auto (on over HTTPS, e.g. ngrok) | true | false
COOKIE_SECURE=auto

# --- Password-reset email (SMTP) ---
# Gmail: smtp.gmail.com, port 587, your Gmail address, and an *app password*
# (Google account > Security > App passwords), not your normal password.
# Left empty: no email is sent; the reset link appears in the backend terminal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Public address of the app for links in emails (e.g. https://xxxx.ngrok-free.dev).
# Empty: taken from the address the doctor used to request the reset.
APP_BASE_URL=
